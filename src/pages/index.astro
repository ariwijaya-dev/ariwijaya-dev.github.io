---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LiveLogStreamer from '@/components/LiveLogStreamer.tsx';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[92vh] flex items-center hero-tech">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-transparent to-purple-500/5"></div>

    <!-- Animated dot grid -->
    <div class="hero-grid absolute inset-0 opacity-50 pointer-events-none"></div>

    <!-- Blueprint circuit pattern -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.15] pointer-events-none" aria-hidden="true">
      <defs>
        <pattern id="circuit-pattern" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
          <path d="M0 60 L60 60 L60 0 M60 60 L120 60 M60 60 L60 120" stroke="#3b82f6" stroke-width="1" fill="none" />
          <circle cx="60" cy="60" r="2.5" fill="#8b5cf6" />
          <circle cx="0" cy="60" r="1.5" fill="#3b82f6" />
          <circle cx="120" cy="60" r="1.5" fill="#3b82f6" />
          <circle cx="60" cy="0" r="1.5" fill="#3b82f6" />
          <circle cx="60" cy="120" r="1.5" fill="#3b82f6" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#circuit-pattern)" />
    </svg>

    <!-- Glow orbs -->
    <div class="absolute -top-32 -left-32 w-[28rem] h-[28rem] rounded-full bg-blue-500/15 blur-3xl pointer-events-none animate-pulse-slow"></div>
    <div class="absolute -bottom-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-purple-500/15 blur-3xl pointer-events-none animate-pulse-slow animate-pulse-delay"></div>

    <!-- Scan lines -->
    <div class="absolute inset-0 hero-scanlines pointer-events-none"></div>

    <!-- Floating code snippets (decorative, hidden on small) -->
    <div class="hidden lg:block absolute top-28 left-6 xl:left-16 z-[2] hero-float hero-float-1">
      <div class="tech-snippet">
        <span class="cs-key">const</span> <span class="cs-var">role</span> <span class="cs-op">=</span> <span class="cs-str">'engineer'</span>
      </div>
    </div>
    <div class="hidden lg:block absolute top-44 right-6 xl:right-16 z-[2] hero-float hero-float-2">
      <div class="tech-snippet">
        <span class="cs-comment">// shipping &gt; talking</span>
      </div>
    </div>
    <div class="hidden lg:block absolute bottom-32 left-12 xl:left-24 z-[2] hero-float hero-float-3">
      <div class="tech-snippet">
        <span class="cs-key">function</span> <span class="cs-fn">build</span>() <span class="cs-brace">{'{ ... }'}</span>
      </div>
    </div>
    <div class="hidden lg:block absolute bottom-44 right-12 xl:right-24 z-[2] hero-float hero-float-4">
      <div class="tech-snippet">
        <span class="cs-key">await</span> <span class="cs-var">deploy</span>(<span class="cs-str">'prod'</span>)
      </div>
    </div>

    <!-- Vignette to keep text legible -->
    <div class="absolute inset-0 z-[3] pointer-events-none hero-vignette"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24 w-full">
      <div class="text-center reveal">
        <!-- Status pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 font-mono text-xs bg-[#0a0a0a]/70 backdrop-blur-sm border border-green-500/30 rounded-full">
          <span class="status-dot"></span>
          <span class="text-green-400">available_for_work</span>
        </div>

        <p class="font-mono text-sm text-blue-400 mb-4 tracking-widest uppercase">// Hello, I'm</p>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold mb-6 tracking-tight hero-title">
          <span class="gradient-text">I Made Pande Ari Wijaya</span>
        </h1>

        <!-- Typed role line -->
        <div class="text-xl sm:text-2xl lg:text-3xl text-gray-200 mb-6 font-mono flex items-center justify-center gap-2 flex-wrap">
          <span class="text-blue-400">&gt;</span>
          <span id="typed-role" class="text-gray-100"></span><span class="cursor-blink">▍</span>
        </div>

        <p class="text-lg sm:text-xl text-gray-400 max-w-3xl mx-auto mb-8">
          Based in Jakarta, Indonesia. I build scalable systems, modern web applications,
          and AI-powered solutions that solve real problems.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-12">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-8 py-3 font-mono text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Get In Touch
          </a>
          <a
            href="/resume.pdf"
            download
            class="inline-flex items-center gap-2 px-8 py-3 font-mono text-sm bg-[#111111] border border-[#222222] hover:bg-[#1a1a1a] hover:border-[#333333] text-gray-300 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download Resume
          </a>
        </div>

        <!-- Tech Stack Badges -->
        <div class="flex flex-wrap justify-center gap-3">
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [Go]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [Python]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [TypeScript]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [React]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [Node.js]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [Docker]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [Kubernetes]
          </span>
          <span class="float-badge px-4 py-2 font-mono text-sm bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-lg text-gray-300 cursor-default">
            [AI/ML]
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="section-kicker font-mono text-sm text-blue-400 mb-2">// About Me</p>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6 text-gray-100">
            Building Software That <span class="gradient-text">Matters</span>
          </h2>
          <div class="space-y-4 text-gray-300">
            <p>
              I am a Software Engineer dedicated to bridging the gap between high-performance backend systems and intuitive frontend design. 
              With a deep foundation in Next.js, Go, and Python, I architect robust solutions that scale.
            </p>
            <p>
              I specialize in designing Service-Oriented Architectures and integrating AI/ML workflows into production-ready environments. 
              By leveraging Docker and cloud-native technologies, I focus on delivering seamless, impactful user experiences that solve complex technical challenges.
            </p>
          </div>

          <!-- Quick Info -->
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-gray-400">Jakarta, Indonesia</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-gray-400">Open to Opportunities</span>
            </div>
          </div>
        </div>

        <!-- Live Log Streamer -->
        <div class="reveal reveal-delay-2 bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl overflow-hidden shadow-2xl shadow-blue-500/5">
          <div class="px-6 py-4 border-b border-[#222222]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-4 font-mono text-sm text-gray-400">system.log</span>
            </div>
          </div>
          <LiveLogStreamer client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-20 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="section-kicker font-mono text-sm text-blue-400 mb-2">// Skills & Expertise</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-100">
          Technologies I Work With
        </h2>
      </div>

      <div class="tilt-stage grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6">
        <!-- Backend -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">Backend</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Go</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Python</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Node.js</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Gin</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">FastAPI</span>
          </div>
        </div></div>

        <!-- Frontend -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-green-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">Frontend</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">React.js</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Next.js</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">TypeScript</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Tailwind</span>
          </div>
        </div></div>

        <!-- AI/ML -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-yellow-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">AI/ML</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">LLMs</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">LangChain</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Mastra</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">AI Agent</span>
          </div>
        </div></div>

        <!-- Databases -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-cyan-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">Databases</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">PostgreSQL</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">MongoDB</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Redis</span>
          </div>
        </div></div>

        <!-- DevOps -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-orange-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">DevOps</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Docker</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Kubernetes</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">CI/CD</span>
          </div>
        </div></div>

        <!-- Cloud -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-pink-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-100">Cloud</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">GCP</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">AWS</span>
            <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Linux</span>
          </div>
        </div></div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="py-20 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="section-kicker font-mono text-sm text-blue-400 mb-2">// Experience</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-100">
          Where I've Worked
        </h2>
      </div>

      <div class="tilt-stage max-w-4xl mx-auto space-y-6">
        <!-- Peepl -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-100">Fullstack Engineer</h3>
              <p class="text-blue-400 font-mono text-sm">Peepl</p>
            </div>
            <div class="mt-2 sm:mt-0 font-mono text-sm text-gray-400">
              May 2024 – Present
            </div>
          </div>
          <p class="text-gray-400 text-sm mb-3">Jakarta, Indonesia</p>
          <ul class="space-y-2 text-gray-300 text-sm">
            <li class="flex gap-2">
              <span class="text-blue-400 mt-1">▹</span>
              <span>Led migration from monolithic Laravel to SOA using Go, Python, and React</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-400 mt-1">▹</span>
              <span>Architected microservices with Docker and Cloud Run on GCP infrastructure</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-400 mt-1">▹</span>
              <span>Built AI-driven candidate summarization engine using Mastra and OpenAI API</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-400 mt-1">▹</span>
              <span>Developed AI scoring system increasing evaluation consistency</span>
            </li>
            <li class="flex gap-2">
              <span class="text-blue-400 mt-1">▹</span>
              <span>Scaled platform to handle 10,000+ concurrent users through optimization and caching strategies</span>
            </li>
          </ul>
        </div></div>

        <!-- Samsung R&D Indonesia -->
        <div class="tilt reveal relative bg-[#111111]/80 backdrop-blur-sm border border-[#222222] rounded-xl p-6 hover:border-blue-500/40 transition-colors" data-tilt><div class="tilt-glow"></div><div class="tilt-inner">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-100">Cloud Frontend Engineer</h3>
              <p class="text-blue-400 font-mono text-sm">Samsung R&D Indonesia</p>
