---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About Me | I Made Pande Ari Wijaya">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-transparent to-purple-500/5" />

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <!-- Header -->
      <div class="text-center mb-16">
        <p class="font-mono text-sm text-blue-400 mb-4">// About Me</p>
        <h1 class="text-4xl sm:text-5xl font-bold mb-6 tracking-tight">
          <span class="gradient-text">I Made Pande Ari Wijaya</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto">
          Software Engineer based in Jakarta, Indonesia
        </p>
      </div>

      <!-- Contact Info -->
      <div class="bg-[#111111] border border-[#222222] rounded-lg p-6 mb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-sm">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="text-gray-400">ari.wijaya.dev@gmail.com</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-gray-400">Jakarta, Indonesia</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="text-gray-400">+62 822-2900-5439</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <a href="https://linkedin.com/in/ariwijaya82" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-blue-400 transition-colors">
              linkedin.com/in/ariwijaya82
            </a>
          </div>
        </div>
      </div>

      <!-- Summary -->
      <div class="mb-16">
        <h2 class="text-2xl font-semibold text-gray-100 mb-6 flex items-center gap-3">
          <span class="font-mono text-blue-400 text-sm">//</span>
          Summary
        </h2>
        <div class="prose prose-invert max-w-none">
          <p class="text-gray-300 leading-relaxed">
            I'm a results-driven Software Engineer with years of experience. Proficient in multiple programming languages,
            I specialize in crafting robust solutions for diverse projects. From scalable backend systems to intuitive
            user interfaces, I thrive on pushing technological boundaries. I bring strong analytical and problem-solving
            skills to every endeavor. As a continuous learner, I stay abreast of emerging trends, ensuring cutting-edge
            contributions.
          </p>
        </div>
      </div>

      <!-- Skills -->
      <div class="mb-16">
        <h2 class="text-2xl font-semibold text-gray-100 mb-6 flex items-center gap-3">
          <span class="font-mono text-blue-400 text-sm">//</span>
          Technical Skills
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6">
            <h3 class="font-mono text-sm text-blue-400 mb-4">Backend</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Go</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Python</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Laravel</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">PHP</span>
            </div>
          </div>
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6">
            <h3 class="font-mono text-sm text-blue-400 mb-4">Frontend</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">React.js</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Vue.js</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">TypeScript</span>
            </div>
          </div>
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6">
            <h3 class="font-mono text-sm text-blue-400 mb-4">Architecture</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">SOA</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">Microservices</span>
              <span class="px-3 py-1 font-mono text-xs bg-[#0a0a0a] border border-[#222222] rounded text-gray-300">REST APIs</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Experience -->
      <div>
        <h2 class="text-2xl font-semibold text-gray-100 mb-6 flex items-center gap-3">
          <span class="font-mono text-blue-400 text-sm">//</span>
          Experience
        </h2>
        <div class="space-y-6">
          <!-- Peepl -->
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6 hover:border-[#333333] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-100">Fullstack Engineer</h3>
                <p class="text-blue-400 font-mono text-sm">Peepl</p>
              </div>
              <div class="mt-2 sm:mt-0 font-mono text-sm text-gray-400">
                May 2024 – Present
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-3">Jakarta, Indonesia</p>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Architected and executed the migration of a legacy monolithic Laravel platform to a Service-Oriented Architecture (SOA), utilizing React, Golang, and Python to improve system modularity and maintainability.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Scaled platform concurrency by decoupling core services, enabling the system to handle high-volume peak-time testing for enterprise clients without performance degradation.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Engineered an AI-driven candidate summarization engine using Python, reducing the time recruiters spend on manual profile reviews by providing automated, data-backed insights.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Developed an automated AI scoring system for interview-style assessments, leveraging AI to standardize evaluation criteria and increase the objectivity of candidate results.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Optimized backend performance by selecting the optimal language for specific services (Golang for high-concurrency tasks, Laravel for rapid feature iteration, and Python for AI/ML integration).</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Designed and implemented responsive frontend interfaces using React, improving the end-user experience for both candidates taking tests and HR administrators analyzing data.</span>
              </li>
            </ul>
          </div>

          <!-- Samsung R&D Indonesia -->
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6 hover:border-[#333333] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-100">Cloud Frontend Engineer</h3>
                <p class="text-blue-400 font-mono text-sm">Samsung R&D Indonesia (SRIN)</p>
              </div>
              <div class="mt-2 sm:mt-0 font-mono text-sm text-gray-400">
                July 2022 – May 2023
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-3">Jakarta, Indonesia</p>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Contributed to a CMS project aimed at managing AI datasets efficiently.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Focused primarily on frontend development, utilizing React.js for building responsive user interfaces.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Collaborated with the backend team to integrate frontend components with backend APIs.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Participated in code reviews, debugging, and testing activities to ensure the reliability and stability of the CMS.</span>
              </li>
            </ul>
          </div>

          <!-- PT. Sinko Prima Alloy -->
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6 hover:border-[#333333] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-100">Software Developer</h3>
                <p class="text-blue-400 font-mono text-sm">PT. Sinko Prima Alloy</p>
              </div>
              <div class="mt-2 sm:mt-0 font-mono text-sm text-gray-400">
                January 2021 – December 2021
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-3">Surabaya, Indonesia</p>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Developed ERP web-based software for the company.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Planned program logic based on company workflow.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Implemented logic using Laravel and Vue framework to build web apps.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Worked closely with stakeholders to troubleshoot system issues and implement enhancements based on feedback.</span>
              </li>
            </ul>
          </div>

          <!-- Humanoid Robotic Team ITS -->
          <div class="bg-[#111111] border border-[#222222] rounded-lg p-6 hover:border-[#333333] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-100">Software Programmer</h3>
                <p class="text-blue-400 font-mono text-sm">Humanoid Robotic Team ITS (ICHIRO)</p>
              </div>
              <div class="mt-2 sm:mt-0 font-mono text-sm text-gray-400">
                January 2018 – December 2020
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-3">Surabaya, Indonesia</p>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Developed algorithms and programmed humanoid robots to walk and play soccer in a team environment.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Implemented robot vision systems to detect the ball and field using color classification and pattern recognition.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Coded in a simulated environment to test an algorithm before running it in a real environment.</span>
              </li>
              <li class="flex gap-2">
                <span class="text-blue-400 mt-1">▹</span>
                <span>Collaborated with teammates to optimize the performance of the robots during competitions.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
